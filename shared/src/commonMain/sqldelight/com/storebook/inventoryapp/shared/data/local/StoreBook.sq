CREATE TABLE items (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL UNIQUE,
  quantity REAL NOT NULL DEFAULT 0.0,
  unit TEXT NOT NULL,
  buy_price REAL NOT NULL DEFAULT 0.0,
  sell_price REAL NOT NULL DEFAULT 0.0,
  low_stock_threshold REAL NOT NULL DEFAULT 0.0,
  category TEXT NOT NULL,
  photo_path TEXT,
  hsn_code TEXT,
  tax_rate REAL NOT NULL DEFAULT 0.0,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  deleted_timestamp INTEGER DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_items_deleted ON items(is_deleted);
CREATE INDEX idx_items_category ON items(category);
CREATE UNIQUE INDEX idx_items_cloud_id ON items(cloud_id);

getAllItems:
SELECT * FROM items WHERE is_deleted = 0;

getActiveItems:
SELECT * FROM items WHERE is_deleted = 0 AND quantity > 0;

getActiveItemsFiltered:
SELECT * FROM items
WHERE is_deleted = 0
  AND (name LIKE '%' || :searchQuery || '%' OR :searchQuery = '')
  AND (
    :category = 'All'
    OR (:category = 'Low Stock' AND quantity <= low_stock_threshold)
    OR category = :category
  )
ORDER BY
  CASE WHEN :sortBy = 'name_asc' THEN name END ASC,
  CASE WHEN :sortBy = 'name_desc' THEN name END DESC,
  CASE WHEN :sortBy = 'price_asc' THEN sell_price END ASC,
  CASE WHEN :sortBy = 'price_desc' THEN sell_price END DESC,
  CASE WHEN :sortBy = 'qty_asc' THEN quantity END ASC,
  CASE WHEN :sortBy = 'qty_desc' THEN quantity END DESC,
  id DESC
LIMIT :limit OFFSET :offset;

getItemById:
SELECT * FROM items WHERE id = ? AND is_deleted = 0;

getDeletedItems:
SELECT * FROM items WHERE is_deleted = 1;

insertItem:
INSERT INTO items(name, quantity, unit, buy_price, sell_price, low_stock_threshold, category, photo_path, hsn_code, tax_rate, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateItem:
UPDATE items SET name = ?, quantity = ?, unit = ?, buy_price = ?, sell_price = ?, low_stock_threshold = ?, category = ?, photo_path = ?, hsn_code = ?, tax_rate = ?, is_synced = 0, updated_at = ? WHERE id = ?;

updateItemStock:
UPDATE items SET quantity = quantity + ?, is_synced = 0, updated_at = ? WHERE id = ?;

softDeleteItem:
UPDATE items SET is_deleted = 1, deleted_timestamp = ?, is_synced = 0, updated_at = ? WHERE id = ?;

restoreItem:
UPDATE items SET is_deleted = 0, deleted_timestamp = 0, is_synced = 0, updated_at = ? WHERE id = ?;

CREATE TABLE sales (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  timestamp INTEGER NOT NULL,
  total_amount REAL NOT NULL,
  discount_amount REAL NOT NULL DEFAULT 0.0,
  customer_name TEXT,
  customer_gstin TEXT,
  business_gstin TEXT,
  customer_address TEXT,
  business_address TEXT,
  type TEXT NOT NULL DEFAULT 'SALE',
  notes TEXT,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_sales_timestamp ON sales(timestamp);

insertSale:
INSERT INTO sales(timestamp, total_amount, discount_amount, customer_name, customer_gstin, business_gstin, customer_address, business_address, type, notes, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSaleById:
SELECT * FROM sales WHERE id = ?;

getAllSales:
SELECT * FROM sales WHERE is_deleted = 0 AND type = 'SALE' ORDER BY timestamp DESC;

getSalesPage:
SELECT * FROM sales
WHERE is_deleted = 0 AND type = 'SALE'
ORDER BY timestamp DESC
LIMIT :limit OFFSET :offset;

getQuotations:
SELECT * FROM sales WHERE is_deleted = 0 AND type = 'ESTIMATE' ORDER BY timestamp DESC;

getSalesByDateRange:
SELECT * FROM sales WHERE is_deleted = 0 AND type = 'SALE' AND timestamp >= ? AND timestamp <= ? ORDER BY timestamp DESC;

updateSaleType:
UPDATE sales SET type = ?, is_synced = 0, updated_at = ? WHERE id = ?;

softDeleteSale:
UPDATE sales SET is_deleted = 1, is_synced = 0, updated_at = ? WHERE id = ?;

CREATE TABLE sale_items (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  sale_id INTEGER NOT NULL,
  item_id INTEGER NOT NULL,
  item_name TEXT NOT NULL,
  unit TEXT NOT NULL,
  quantity REAL NOT NULL,
  sell_price REAL NOT NULL,
  buy_price REAL NOT NULL,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_sale_items_sale_id ON sale_items(sale_id);

insertSaleItem:
INSERT INTO sale_items(sale_id, item_id, item_name, unit, quantity, sell_price, buy_price, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getSaleItemsBySaleId:
SELECT * FROM sale_items WHERE sale_id = ? AND is_deleted = 0;

CREATE TABLE udhaar (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  customer_name TEXT NOT NULL,
  amount REAL NOT NULL,
  type TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  notes TEXT,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_udhaar_customer ON udhaar(customer_name);

insertUdhaar:
INSERT INTO udhaar(customer_name, amount, type, timestamp, notes, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

getCustomerLedger:
SELECT * FROM udhaar WHERE customer_name = ? AND is_deleted = 0 ORDER BY timestamp ASC;

getAllUdhaar:
SELECT * FROM udhaar WHERE is_deleted = 0;

CREATE TABLE expenses (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  type TEXT NOT NULL,
  description TEXT NOT NULL,
  amount REAL NOT NULL,
  timestamp INTEGER NOT NULL,
  supplier_name TEXT,
  supplier_phone TEXT,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_expenses_timestamp ON expenses(timestamp);

insertExpense:
INSERT INTO expenses(type, description, amount, timestamp, supplier_name, supplier_phone, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

getAllExpenses:
SELECT * FROM expenses WHERE is_deleted = 0 ORDER BY timestamp DESC;

CREATE TABLE suppliers (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL UNIQUE,
  phone TEXT,
  gstin TEXT,
  address TEXT,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

insertSupplier:
INSERT INTO suppliers(name, phone, gstin, address, updated_at)
VALUES (?, ?, ?, ?, ?);

getAllSuppliers:
SELECT * FROM suppliers WHERE is_deleted = 0;

softDeleteSupplier:
UPDATE suppliers SET is_deleted = 1, is_synced = 0, updated_at = ? WHERE id = ?;

CREATE TABLE purchases (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  supplier_id INTEGER NOT NULL,
  supplier_name TEXT NOT NULL,
  total_amount REAL NOT NULL,
  tax_amount REAL NOT NULL DEFAULT 0.0,
  type TEXT NOT NULL DEFAULT 'BILL',
  timestamp INTEGER NOT NULL,
  notes TEXT,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_purchases_timestamp ON purchases(timestamp);

insertPurchase:
INSERT INTO purchases(supplier_id, supplier_name, total_amount, tax_amount, type, timestamp, notes, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getAllPurchases:
SELECT * FROM purchases WHERE is_deleted = 0 ORDER BY timestamp DESC;

getPurchasesByDateRange:
SELECT * FROM purchases WHERE is_deleted = 0 AND timestamp >= ? AND timestamp <= ? ORDER BY timestamp DESC;

CREATE TABLE purchase_items (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  purchase_id INTEGER NOT NULL,
  item_id INTEGER NOT NULL,
  item_name TEXT NOT NULL,
  quantity REAL NOT NULL,
  unit TEXT NOT NULL,
  buy_price REAL NOT NULL,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_purchase_items_purchase_id ON purchase_items(purchase_id);

insertPurchaseItem:
INSERT INTO purchase_items(purchase_id, item_id, item_name, quantity, unit, buy_price, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

getPurchaseItemsByPurchaseId:
SELECT * FROM purchase_items WHERE purchase_id = ? AND is_deleted = 0;

CREATE TABLE item_batches (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  item_id INTEGER NOT NULL,
  batch_number TEXT,
  expiry_date INTEGER,
  quantity REAL NOT NULL DEFAULT 0,
  cost_price REAL NOT NULL DEFAULT 0,
  timestamp INTEGER NOT NULL,
  notes TEXT,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  cloud_id TEXT,
  is_synced INTEGER NOT NULL DEFAULT 0,
  updated_at INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_item_batches_item_id ON item_batches(item_id);

insertItemBatch:
INSERT INTO item_batches(item_id, batch_number, expiry_date, quantity, cost_price, timestamp, notes, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getBatchesForItem:
SELECT * FROM item_batches WHERE item_id = ? AND is_deleted = 0 ORDER BY timestamp DESC;

getNearExpiryBatches:
SELECT * FROM item_batches WHERE is_deleted = 0 AND expiry_date IS NOT NULL AND expiry_date <= ? ORDER BY expiry_date ASC;

softDeleteItemBatch:
UPDATE item_batches SET is_deleted = 1, is_synced = 0, updated_at = ? WHERE id = ?;

-- Maintenance Queries
clearItems:
DELETE FROM items;

clearSales:
DELETE FROM sales;

clearSaleItems:
DELETE FROM sale_items;

clearUdhaar:
DELETE FROM udhaar;

clearExpenses:
DELETE FROM expenses;

clearSuppliers:
DELETE FROM suppliers;

clearPurchases:
DELETE FROM purchases;

clearPurchaseItems:
DELETE FROM purchase_items;

clearItemBatches:
DELETE FROM item_batches;

-- Sync Queries

getUnsyncedItems:
SELECT * FROM items WHERE is_synced = 0;

markItemSynced:
UPDATE items SET is_synced = 1, cloud_id = :cloudId WHERE id = :id;

getUnsyncedSales:
SELECT * FROM sales WHERE is_synced = 0;

markSaleSynced:
UPDATE sales SET is_synced = 1, cloud_id = :cloudId WHERE id = :id;

getUnsyncedSaleItems:
SELECT * FROM sale_items WHERE is_synced = 0;

markSaleItemSynced:
UPDATE sale_items SET is_synced = 1, cloud_id = :cloudId WHERE id = :id;

getLastInsertRowId:
SELECT last_insert_rowid();

deleteAllItems:
DELETE FROM items;

deleteAllSales:
DELETE FROM sales;

deleteAllSaleItems:
DELETE FROM sale_items;

deleteAllUdhaar:
DELETE FROM udhaar;

deleteAllExpenses:
DELETE FROM expenses;

deleteAllSuppliers:
DELETE FROM suppliers;

deleteAllPurchases:
DELETE FROM purchases;

deleteAllPurchaseItems:
DELETE FROM purchase_items;

deleteAllItemBatches:
DELETE FROM item_batches;
